# Where projects, media and renders are stored (default: ./storage)
STUDIO_STORAGE_DIR=./storage
# Optional: ffmpeg/ffprobe binaries when they are not on PATH (default: ffmpeg, ffprobe)
STUDIO_FFMPEG_PATH=
STUDIO_FFPROBE_PATH=
# Optional: Chrome/Chromium path for Remotion rendering (default: Remotion downloads its own)
STUDIO_BROWSER_EXECUTABLE=
# Largest accepted upload in MB (default: 1024)
STUDIO_MAX_UPLOAD_MB=

# Optional: PostgreSQL (ADR 0005). Empty → projects, jobs and the SFX library stay in JSON files under storage/.
# After setting it: pnpm db:migrate, then pnpm db:import to copy existing JSON data. URL-encode special
# characters in the password (@ → %40, # → %23, / → %2F, : → %3A).
DATABASE_URL=
# Tests only: the Postgres adapter tests create and drop temporary databases here (needs CREATEDB).
# Empty → those tests are skipped.
TEST_DATABASE_URL=

# ElevenLabs text-to-speech (M8). Empty → voice generation is hidden; Manual mode needs no key.
# The key needs the "Text to Speech" and "Voices: read" permissions.
ELEVENLABS_API_KEY=
# Optional: voice preselected for new projects (otherwise pick one in the UI)
ELEVENLABS_DEFAULT_VOICE_ID=
# Optional: eleven_flash_v2_5 (default, 0.5 credit/char) or eleven_v3 (1 credit/char); both speak Vietnamese
ELEVENLABS_DEFAULT_MODEL_ID=
# Price of one credit in USD for cost estimates (default 0.0006 = 6 USD / 10 000 credits)
ELEVENLABS_USD_PER_CREDIT=

# Claude API (M9): AI script, scene planning, visual keywords. Empty → AI features are hidden.
# Create the key in Claude Console (platform.claude.com → API Keys); billed separately from Claude Pro.
ANTHROPIC_API_KEY=
# Optional: claude-sonnet-5-5 (default), claude-haiku-4-5 (cheaper) or claude-opus-5-5
AI_MODEL=

# Budgets for every paid call, AI and TTS (M11). Only defaults: once saved on the settings page (/settings)
# the saved values apply. In USD; empty → default, "none" → no limit, 0 → blocks every paid call.
# Per call (worst case of one call, default 0.5)
BUDGET_MAX_USD_PER_CALL=
# Rolling 24 hours (default 2)
BUDGET_MAX_USD_PER_DAY=
# Calendar month, Vietnam time (default 20)
BUDGET_MAX_USD_PER_MONTH=
# All-time spend of each project (default 1)
BUDGET_MAX_USD_PER_PROJECT=

# Free stock media search (M10). Empty → that source is hidden; the shared library works without keys.
# Pexels: pexels.com/api → "Your API Key". Pixabay: pixabay.com/api/docs (log in, the key is shown there).
PEXELS_API_KEY=
PIXABAY_API_KEY=
