{
  "name": "shorts-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @studio/web --filter @studio/worker dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --root packages/domain --coverage",
    "render": "pnpm --filter @studio/worker render",
    "demo": "pnpm --filter @studio/worker demo",
    "clip:shots": "pnpm --filter @studio/worker clip:shots",
    "db:generate": "pnpm --filter @studio/adapters db:generate",
    "db:migrate": "pnpm --filter @studio/worker db:migrate",
    "db:import": "pnpm --filter @studio/worker db:import",
    "arch": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arch && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.8",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
